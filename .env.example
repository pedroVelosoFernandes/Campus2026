# Copie para .env (já ignorado pelo git) e preencha.
# Atenção: variáveis com prefixo EXPO_PUBLIC_ vão para o bundle do app.
# NUNCA coloque segredos em variáveis EXPO_PUBLIC_.

# --- Servidor (rotas /api, nunca enviadas ao app) ---
# Chave do projeto OpenAI. Usada só pelas rotas /api/live-session,
# /api/assistant-text e /api/analyze-symptoms. Não há client secret efêmero:
# a chave nunca sai do servidor.
OPENAI_API_KEY=
# Modelo de voz do GPT-Live (fala com a pessoa via WebRTC).
OPENAI_LIVE_MODEL=gpt-live-1
# Backend de delegação Responses = modelo de sintomas/orientação SUS.
# O modelo especializado do Alô Saúde ainda não existe; por enquanto é o GPT-Sol.
SYMPTOM_MODEL=gpt-6-sol
# Origens web permitidas nas rotas /api, separadas por vírgula (opcional).
# Apps nativos não enviam Origin. Isto NÃO é autenticação.
ALLOWED_ORIGINS=

# --- App (públicas) ---
# URL do servidor das rotas /api (ex.: http://192.168.0.10:8081 em dev, ou o domínio do deploy).
# Se vazia, o assistente roda com a conversa simulada (mock).
EXPO_PUBLIC_API_URL=
# 1 = força a conversa simulada, sem chamar a OpenAI (útil para demos das telas).
EXPO_PUBLIC_VOICE_MOCK=0
